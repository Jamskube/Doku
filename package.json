  "type": "module",
  "scripts": {
    "dev": "vite",
    "material-lab": "vite --port 1421 --host 127.0.0.1 --open /spike/material-lab/",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "subset:icons": "node scripts/subset-icons.mjs",
    "prepare:ollama:arm64": "node scripts/prepare-ollama-sidecar.mjs arm64",
    "prepare:ollama:x64": "node scripts/prepare-ollama-sidecar.mjs x64",
    "build:installer:arm64": "npm run prepare:ollama:arm64 && tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "build:installer:x64": "npm run prepare:ollama:x64 && tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri": "tauri"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "@fontsource/geist-mono": "^5.2.0",
    "@lezer/highlight": "^1.2.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "codemirror": "^6.0.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.11",
    "marked": "^18.0.6",
    "mupdf": "^1.28.0",
    "pdfjs-dist": "^6.2.108",
    "superdoc": "^2.6.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.10.0",
    "jsdom": "^29.1.1",
    "material-symbols": "^0.36.0",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
