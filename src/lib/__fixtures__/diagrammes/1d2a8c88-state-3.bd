type state { title: "Cycle de vie local d’une licence" }
graph { background: #0b1120 padding: 32 gap: 54 }

style state { fill: #1e293b stroke: #38bdf8 1.5 font: 13 #e2e8f0 padding: 16 }
style edge  { stroke: #64748b 1.5 font: 11 #94a3b8 }
style group { stroke: #f59e0b 1.2 font: 11 #f59e0b fill: #f59e0b0c }

state begin { kind: initial }
state none "Aucune licence" right-of begin gap 46
state active "Licence valide active" right-of none gap 90
state renewal "Renouvellement accepté" below active gap 62
state refused "Renouvellement refusé" below renewal gap 54
state invalid "Nouvelle licence invalide\nancienne conservée" below active gap 62
state restricted "Licence expirée\nmode restreint" right-of invalid gap 76
state revoked "Droit révoqué /\nnon-réémission" below restricted gap 62
state stop { kind: final } right-of revoked gap 46

begin -> none
none -> active "saisie puis vérification complète"
active -> renewal "renouvellement accepté"
renewal -> active "installation atomique"
active -> refused "droit retiré ou identité divergente"
refused -> active "licence courante encore valide"
active -> invalid "signature, produit ou token invalide"
invalid -> active "ancienne licence intacte"
active -> restricted "expiration"
restricted -> active "nouvelle licence valide"
active -> revoked "révocation Online ou non-réémission Offline"
revoked -> stop