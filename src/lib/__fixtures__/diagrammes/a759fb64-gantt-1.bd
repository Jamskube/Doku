type gantt {
  title: "Roadmap — atteindre le local dashboard sans VPN"
  size: 560 26
  today: 2026-09-14
}
graph { background: #0b1120 padding: 32 }
style task  { font: 12 #e2e8f0 }
style group { stroke: #334155 1 font: 11 #94a3b8 fill: #ffffff06 radius: 4 }

group init "J0 · état initial" {
  task portail "Portail du device seul" 2026-09-14 3d
  task pasapi  "Pas d'API · pas de passerelle" 2026-09-14 3d
}

group gw "J1 · passerelle" {
  task buildgw  "Construire la passerelle"  2026-09-17 15d
  task transit  "Trafic devices → passerelle" 2026-09-24 8d
}

group obs "J2 · observation" {
  task watch   "Observer gabarits réels"  2026-10-01 5d
  task usages  "Recenser 8 types + 5/6.policy" 2026-10-06 4d
}

group api "J3 · API gabarits" {
  task design  "Concevoir API (8 gabarits)"  2026-10-11 6d
  task expose  "Exposer en lecture au global" 2026-10-18 4d
}

group val "J4 · validation terrain" {
  task fw      "Vérifier firmware récent"  2026-10-25 3d
  task sign    "Valider classement API/portail" 2026-10-28 4d
}

group live "J5 · bascule sans VPN" {
  task local   "Local dashboard exposé"  2026-11-02 5d
  task global  "Global dashboard en lecture" 2026-11-02 5d
  task parite  "Parité partielle · 1 modèle config" 2026-11-07 3d
}